<!-- Loaded only in CLion: see the optional dependency in plugin.xml. -->
<idea-plugin>
  <!-- CidrRunConfiguration and the runner API come from here. -->
  <depends>com.intellij.nativeDebug</depends>

  <extensions defaultExtensionNs="com.github.samg101developer.sppidea">
    <runConfigurationProvider
        implementation="com.github.samg101developer.sppidea.clion.SppCidrRunConfiguration$Provider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <programRunner
        implementation="com.github.samg101developer.sppidea.clion.SppCidrProgramRunner"
        order="first"/>
    <!-- Ahead of CLion's own, which would take the configuration for a C++ one. -->
    <programRunner
        implementation="com.github.samg101developer.sppidea.clion.SppCidrDebugRunner"
        order="first"/>
  </extensions>

  <!-- Line breakpoints in .spp files, for the native debugger. -->
  <extensions defaultExtensionNs="cidr.debugger">
    <lineBreakpointFileTypesProvider
        implementation="com.github.samg101developer.sppidea.clion.SppLineBreakpointFileTypes"/>
  </extensions>
</idea-plugin>
